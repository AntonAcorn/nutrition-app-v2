{
  "name": "nutrition-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node scripts/patch-ios.js",
    "cap:sync": "npx cap sync ios && node scripts/patch-ios.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tests/smoke/run-all.js",
    "test:smoke:ci": "start-server-and-test 'vite --host 127.0.0.1 --port 5174' http://127.0.0.1:5174 'npm run test:smoke'",
    "test:all": "npm test && npm run test:smoke:ci"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capgo/capacitor-health": "^8.4.9",
    "@sentry/react": "^10.51.0",
    "@tanstack/react-query": "^5.100.9",
    "@zxing/browser": "^0.2.0",
    "posthog-js": "^1.372.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "puppeteer-core": "^24.43.0",
    "start-server-and-test": "^3.0.2",
    "typescript": "^6.0.2",
    "vite": "^5.4.2",
    "vitest": "^4.1.5"
  }
}
