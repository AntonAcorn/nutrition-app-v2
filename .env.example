# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=nutrition_app
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=change-me

# ─── App ────────────────────────────────────────────────────────────────────
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost:8080
CADDY_SITE_ADDRESS=localhost

# ─── AI: photo & voice analysis ─────────────────────────────────────────────
PHOTO_ANALYSIS_ENABLED=true
PHOTO_ANALYSIS_PROVIDER=openai-stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=25000
AI_ANALYSIS_DAILY_LIMIT=30

# ─── AI: coach insights ─────────────────────────────────────────────────────
COACH_ENABLED=true
COACH_PROVIDER=openai
COACH_MODEL=gpt-4o-mini
COACH_OPENAI_API_KEY=
COACH_VALIDITY_HOURS=72
COACH_MIN_LOGGED_DAYS=3
COACH_TIMEOUT_MS=30000

# ─── OAuth: Google ──────────────────────────────────────────────────────────
# Web flow (server-side redirect):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native iOS/Android client IDs that may appear as `aud` on native ID tokens.
# Comma-separated. Without these, native Google Sign-In will reject every token.
GOOGLE_NATIVE_CLIENT_IDS=

# ─── Email (SMTP) — used for verify + password reset ────────────────────────
# Production uses Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587,
# SMTP_USER=resend, SMTP_PASSWORD=<Resend API key starting with re_>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From address on outbound emails. Must be on a domain verified in your
# SMTP provider (Resend domain verification page).
MAIL_FROM=noreply@rumblyeats.org

# ─── Trial gaming protection ────────────────────────────────────────────────
# SHA-256 salt for the email hash that stops a user from deleting their
# account and re-registering with the same email to claim a fresh 7-day
# Pro trial. Set to any random 32+ character string; do NOT rotate it
# after launch or all existing hashes become stale.
TRIAL_EMAIL_SALT=

# ─── Admin (comp Pro grants for friends / press / influencers) ─────────────
# Bearer token for /api/admin/grant-pro, /api/admin/revoke-pro,
# /api/admin/entitlement. Pick a long random string (openssl rand -hex 32)
# and store in a password manager. Without it the endpoints 503.
NUTRITION_ADMIN_TOKEN=

# ─── Paywall (monetization flip) ────────────────────────────────────────────
# false (default) = open beta — everyone is treated as PRO with the
#                   higher OPEN_BETA_* daily caps. PaywallSheet shows
#                   "Coming soon" plans.
# true            = real tier resolution kicks in (FREE / TRIAL / PRO /
#                   FOUNDER), AI gates enforce per-tier quotas, RevenueCat
#                   webhook updates pro_active_until and founder_number.
PAYWALL_ENABLED=false

# ISO-8601 timestamp of when the paywall went live. Used to grandfather
# existing beta users: anyone whose trial expired BEFORE this date gets a
# fresh 7-day trial counted from launch instead of dropping straight to
# FREE. Set when flipping PAYWALL_ENABLED=true.
# Example: PAYWALL_LAUNCHED_AT=2026-06-15T00:00:00Z
PAYWALL_LAUNCHED_AT=

# ─── Push notifications (Web Push / VAPID) ──────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Push notifications (Android / FCM) ─────────────────────────────────────
# Source from a Firebase service-account JSON key:
# Firebase Console → Project settings → Service accounts → Generate new key.
# The downloaded JSON has fields project_id / client_email / private_key —
# paste them here. private_key contains real newlines; replace each with
# the two characters \n (backslash-n) so it fits on one env line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Push notifications (iOS / APNs) ────────────────────────────────────────
# Apple Push Notification service - .p8 key from Apple Developer Account.
# environment: 'production' for TestFlight / App Store builds,
#              'development' for locally-installed Xcode debug builds.
# Wrong gateway silently drops the push.
NUTRITION_PUSH_APNS_KEY=
NUTRITION_PUSH_APNS_KEY_ID=
NUTRITION_PUSH_APNS_TEAM_ID=
NUTRITION_PUSH_APNS_BUNDLE_ID=com.aiduparc.rumblyeats
NUTRITION_PUSH_APNS_ENVIRONMENT=production

# ─── Observability ──────────────────────────────────────────────────────────
# Without these, app errors stay in the container logs only - no remote alerts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_VAPID_PUBLIC_KEY=
